# ============================================================================
# ENVIRONMENT CONFIGURATION FOR VOLENTRY
# ============================================================================
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local to git (it contains secrets)
# ============================================================================

# ============================================================================
# AZURE SERVICES
# ============================================================================

# CosmosDB (event log + data storage)
AZURE_COSMOSDB_ENDPOINT=https://<account-name>.documents.azure.com:443/
AZURE_COSMOSDB_KEY=<primary-or-secondary-key>
AZURE_COSMOSDB_DATABASE_NAME=volentry-dev

# Azure Service Bus (signup queue for concurrency safety)
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://<namespace-name>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>
AZURE_SERVICEBUS_QUEUE_NAME=volunteer-signups

# Azure SignalR Service (real-time updates)
AZURE_SIGNALR_CONNECTION_STRING=Endpoint=https://<service-name>.service.signalr.net;AccessKey=<key>;Version=1.0

# Azure Communication Services (email confirmations)
AZURE_COMMUNICATION_SERVICES_CONNECTION_STRING=endpoint=https://<resource-name>.communication.azure.com/;accesskey=<key>

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# Email Configuration
EMAIL_FROM_ADDRESS=noreply@volentry.com
EMAIL_FROM_NAME=Volentry
ADMIN_EMAIL_ADDRESS=support@volentry.com
ADMIN_PHONE_NUMBER=+1-555-123-4567

# Organization Configuration
DEFAULT_ORG_NAME=test-club
DEFAULT_ORG_DISPLAY_NAME=Test Youth Club

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT Secret (must be 32+ characters, random)
JWT_SECRET=your-super-secret-random-key-min-32-characters-long
JWT_EXPIRY_HOURS=24
JWT_ISSUER=volentry
JWT_AUDIENCE=volentry-api

# Admin Invite Token
INVITE_TOKEN_EXPIRY_HOURS=24

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=Debug
LOG_PATH=./logs

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Real-time updates
ENABLE_REALTIME_UPDATES=true

# Email sending
ENABLE_EMAIL_SENDING=true

# DDoS protection
ENABLE_RATE_LIMITING=true

# ============================================================================
# PERFORMANCE & LIMITS
# ============================================================================

# Rate limiting (requests per minute per IP)
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Signup queue polling interval (milliseconds)
SIGNUP_QUEUE_POLL_INTERVAL_MS=100

# Event log query batch size
EVENT_LOG_BATCH_SIZE=100

# ============================================================================
# DEPLOYMENT (CI/CD)
# ============================================================================

# Azure App Service (if deploying to App Service)
WEBSITE_RUN_FROM_PACKAGE=1

# ============================================================================
# LOCAL DEVELOPMENT
# ============================================================================

# Docker
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Database seeding (auto-populate test data)
SEED_TEST_DATA=true

# Email preview (instead of sending, show in console/file)
EMAIL_PREVIEW_MODE=false
EMAIL_PREVIEW_FILE=./email-preview.html
